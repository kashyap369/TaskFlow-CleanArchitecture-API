{
  "ClientSettings": {
    "BaseUrl": "http://localhost:4200"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "LiveKit": {
    "Enabled": true,
    "Url": "ws://localhost:7880",
    "ApiKey": "devkey",
    "ApiSecret": "secretsecretsecretsecretsecretsecret",
    "WebhookToleranceSeconds": 300,
    "EgressLocalOutputPath": "/out"
  },
  "Meetings": {
    "Enabled": true,
    "GuestsEnabled": false,
    "RecordingEnabled": true,
    "GuestSessionMinutes": 60,
    "DefaultRetentionDays": 90,
    "MaxFileBytes": 26214400,
    "RecordingConsentTimeoutSeconds": 60,
    "MaxParticipantsPerMeeting": 50,
    "MaxConcurrentLiveMeetingsPerOrganization": 10,
    "MaxConcurrentRecordings": 1,
    "MaxMessagesPerMeeting": 5000,
    "MaxAssetsPerMeeting": 100,
    "MaxStorageBytesPerMeeting": 262144000,
    "GuestAccessRecordRetentionDays": 30
  },
  "ObjectStorage": {
    "Provider": "Local",
    "LocalPath": "App_Data/objects"
  }
}
