{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=TaskFlowDb;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Planner": {
    "Enabled": true,
    "SlowRequestMilliseconds": 1500
  },
  "LiveKit": {
    "Enabled": false,
    "Url": "ws://localhost:7880",
    "ApiKey": "devkey",
    "ApiSecret": "replace-with-a-secret-at-least-32-characters-long",
    "WebhookToleranceSeconds": 300
  },

  "AllowedHosts": "*",
  "ClientSettings": {
    "BaseUrl": "http://localhost:4200"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "ObjectStorage": {
    "Provider": "S3",
    "Endpoint": "http://localhost:9000",
    "PublicEndpoint": "https://s3.example.com",
    "AccessKey": "YOUR_S3_ACCESS_KEY",
    "SecretKey": "YOUR_S3_SECRET_KEY",
    "Bucket": "taskflow",
    "UseSsl": false,
    "ForcePathStyle": true
  },
  "JwtSettings": {
    "Issuer": "TaskFlow.Api",
    "Audience": "TaskFlow.Client",
    "SecretKey": "YOUR_JWT_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "OneTimeCodeSettings": {
    "SecretKey": "YOUR_SEPARATE_OTP_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG"
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "YOUR_EMAIL@gmail.com",
    "Password": "YOUR_APP_PASSWORD",
    "FromEmail": "YOUR_EMAIL@gmail.com",
    "FromName": "TaskFlow.Inc",
    "EnableSsl": true
  }

}
